{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:production",
  "regions": ["iad1"],
  "crons": [{ "path": "/api/cron/cleanup", "schedule": "0 7 * * *" }],
  "git": {
    "deploymentEnabled": {
      "feature/**": false,
      "fix/**": false,
      "refactor/**": false,
      "docs/**": false
    }
  }
}
