# Postgres connection string. Local dev uses the bundled Postgres; production uses Neon (pooled URL).
DATABASE_URL=postgres://presu:presu@localhost:5432/presu

# Random string, at least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app, without a trailing slash
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Auth Platform > Clients > Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
